{
  "name": "ply",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "shots": "tsx scripts/screenshots.ts",
    "layouts": "tsx scripts/layouts.ts",
    "optimizer": "cd ../optimizer && cargo build --release --target wasm32-unknown-unknown --lib && node -e \"require('fs').copyFileSync('target/wasm32-unknown-unknown/release/ply_optimizer.wasm','../app/public/fsrs/ply_optimizer.wasm')\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "playwright": "1.56",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "stockfish": "^19.0.1",
    "ts-fsrs": "^5.4.2"
  }
}
